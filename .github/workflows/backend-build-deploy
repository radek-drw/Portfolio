name: Backend Deploy (DEV)

on:
  push:
    branches:
      - dev
    paths:
      - 'backend/src/**'
permissions:
  contents: read
  id-token: write

jobs:
  deploy-lambda:
    runs-on: ubuntu-latest

    steps:
      # checkout repo
      - name: Checkout code
        uses: actions/checkout@v6

      # node setup
      - name: Setup Node.js
        uses: actions/setup-node@v6
        with:
          node-version: 24.13.0
          cache: pnpm
          cache-dependency-path: pnpm-lock.yaml

      # install dependencies
      - name: Install dependencies
        run: pnpm install --frozen-lockfile --filter backend
        shell: bash
        env:
          CI: true

      # build lambda
      - name: Build lambda
        run: pnpm --filter backend run build:lambda contact-form
        shell: bash

      # login to AWS via OIDC
      - name: Configure AWS credentials
        uses: aws-actions/configure-aws-credentials@v6
        with:
          role-to-assume: arn:aws:iam::${{ secrets.AWS_ACCOUNT_ID }}:role/github-actions-lambda-dev-role
          aws-region: eu-west-1

      # deploy new lambda code
      - name: Deploy Lambda
        run: |
          aws lambda update-function-code \
            --function-name dev-contact-form-lambda \
            --zip-file fileb://backend/dist/contact-form.zip
