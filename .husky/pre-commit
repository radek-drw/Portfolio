# =================================
# VALIDATE TERRAFORM FILES | tflint
# =================================
# Checks that TFLint is installed
if ! command -v tflint; then
  echo "TFLint is not installed"
  exit 1
fi

# Run TFLint only in Terraform directories affected by staged changes. 
# This avoids scanning the entire infra/ directory on every commit, making the pre-commit check faster
for dir in $(git diff --cached --name-only \
  | grep '^infra/.*\.tf$' \
  | xargs -r -n1 dirname \
  | sort -u); do
  (cd "$dir" && tflint)
done

# =============================================
# UPDATE TERRAFORM MODULE DOCS | terraform-docs
# =============================================
# Checks that terraform-docs is installed
if ! command -v terraform-docs; then
  echo "terraform-docs is not installed"
  exit 1
fi

# Update documentation only for Terraform modules affected by staged changes.
# This avoids regenerating documentation for every module on every commit.
# terraform-docs modifies README.md files, so the updated files must be staged again
# before the commit. This script automatically stages the updated README.md files
for dir in $(git diff --cached --name-only \
  | grep '^infra/modules/.*\.tf$' \
  | xargs -r -n1 dirname \
  | sort -u); do

  terraform-docs markdown table "$dir" \
    --output-file README.md \
    --output-mode inject

  git add "$dir/README.md"
done