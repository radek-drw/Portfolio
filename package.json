{
  "name": "portfolio",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.1",
  "engines": {
    "node": ">=24.13.0 <25",
    "npm": "project-uses-pnpm"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "eslint": "^9.38.0",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.4",
    "prettier": "^3.6.2"
  },
  "scripts": {
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "lint-staged": "lint-staged --quiet",
    "prepare": "husky"
  },
  "lint-staged": {
    "**/*.{js,jsx,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{json,scss,css,md}": [
      "prettier --write"
    ],
    "**/*.{tf,tfvars}": [
      "terraform fmt"
    ]
  }
}
